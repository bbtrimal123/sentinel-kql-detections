
let TimeWindow = 15m;
let MinimumUsers = 10;
let MinimumFailures = 20;
SigninLogs
| where TimeGenerated > ago(24h)
| where ResultType != "0"
| where isnotempty(IPAddress)
| summarize
    FailedAttempts = count(),
    TargetedUsers = dcount(UserPrincipalName),
    Users = make_set(UserPrincipalName, 20),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, TimeWindow)
| where FailedAttempts >= MinimumFailures
    and TargetedUsers >= MinimumUsers
| project
    TimeGenerated,
    IPAddress,
    FailedAttempts,
    TargetedUsers,
    Users,
    FirstSeen,
    LastSeen
| order by FailedAttempts desc
